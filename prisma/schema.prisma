generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                           Int              @id @default(autoincrement())
  email                        String           @unique
  password                     String
  name                         String
  surname                      String
  birthDate                    DateTime
  matricola                    String           @unique
  department                   String
  degreeCourse                 String
  isFuorisede                  Boolean
  qrToken                      String           @unique @default(uuid())
  createdAt                    DateTime         @default(now())
  resetToken                   String?          @unique
  resetTokenExpiry             DateTime?
  newsletter                   Boolean          @default(false)
  role                         Role             @default(USER)
  association                  Association      @default(MORGANA_ORUM)
  accettazioneTerminiCondivisi Boolean          @default(false) @map("accettazione_termini_condivisi")
  consensoMarketingMorgana     Boolean          @default(false) @map("consenso_marketing_morgana")
  consensoMarketingOrum        Boolean          @default(false) @map("consenso_marketing_orum")
  emailVerified                Boolean          @default(false)
  verificationToken            String?          @unique
  gradeSimulation              GradeSimulation?
  registrations                Registration[]
  conventionScans              ConventionScan[]
}

model Event {
  id             Int            @id @default(autoincrement())
  title          String
  description    String
  date           DateTime
  location       String
  image          String?
  category       String
  attachments    String?
  bookingEnd     DateTime?
  bookingOpen    Boolean        @default(true)
  bookingStart   DateTime?
  details        String?
  endDate        DateTime?
  cfuDepartments String?
  cfuType        String?
  cfuValue       String?
  published      Boolean        @default(true)
  associations   Association[]  @default([MORGANA_ORUM])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  youtubeUrl     String?
  descriptionEn  String?
  detailsEn      String?
  titleEn        String?
  registrations  Registration[]

  @@index([date])
  @@index([category])
}

model Registration {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  status    String   @default("REGISTERED")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model Representative {
  id              String      @id @default(uuid())
  name            String
  listName        String
  category        String
  department      String?
  role            String?
  term            String      @default("2025-2027")
  image           String?
  email           String?
  phone           String?
  instagram       String?
  description     String?
  roleDescription String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  association     Association @default(MORGANA_ORUM)
  mandateYears    Int         @default(2)
}

model News {
  id            String        @id @default(uuid())
  title         String
  description   String
  content       String?
  category      String
  tags          String?
  image         String?
  date          DateTime      @default(now())
  published     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  associations  Association[] @default([MORGANA_ORUM])
  contentEn     String?
  descriptionEn String?
  titleEn       String?
  attachments   String?

  @@index([date])
  @@index([category])
}

model Convention {
  id        String   @id @default(uuid())
  name      String
  category  String
  social    String?
  logo      String?
  website   String?
  location  String
  discounts String[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  partnerUsers PartnerUser[]
  scans        ConventionScan[]

  @@index([location])
  @@index([category])
}

model PartnerUser {
  id           String           @id @default(uuid())
  email        String           @unique
  password     String
  name         String
  conventionId String
  createdAt    DateTime         @default(now())
  convention   Convention       @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  scans        ConventionScan[]
}

model ConventionScan {
  id           String       @id @default(uuid())
  conventionId String
  userId       Int
  scannedById  String?
  createdAt    DateTime     @default(now())
  convention   Convention   @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scannedBy    PartnerUser? @relation(fields: [scannedById], references: [id], onDelete: SetNull)

  @@index([conventionId])
  @@index([userId])
  @@index([createdAt])
}

model NewsCategory {
  id   String @id @default(uuid())
  name String @unique
}

model EventCategory {
  id   String @id @default(uuid())
  name String @unique
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  link      String?
  createdAt DateTime @default(now())
  messageEn String?
  titleEn   String?

  @@index([createdAt])
}

model AnalyticEvent {
  id        Int      @id @default(autoincrement())
  type      String
  page      String?
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PiazzaArtist {
  id        String   @id @default(uuid())
  name      String
  role      String
  category  String
  bio       String
  image     String?
  badge     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PiazzaProgramItem {
  id          String   @id @default(uuid())
  title       String
  description String
  timeSlot    String
  startTime   String?
  endTime     String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  location    String?
}

model PiazzaMediaItem {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String?
  url         String?
  thumbnail   String?
  personName  String?
  personRole  String?
  duration    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PiazzaSettings {
  id               String   @id @default("settings")
  year             String   @default("2026")
  countdownVisible Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  eventDate        DateTime @default(dbgenerated("'2026-05-22 09:00:00'::timestamp without time zone"))
}

model PiazzaSponsor {
  id        String   @id @default(uuid())
  name      String
  logo      String?
  website   String?
  tier      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganigrammaMember {
  id          String                  @id @default(uuid())
  name        String
  role        String
  roleEn      String?
  email       String?
  association OrganigrammaAssociation
  section     OrganigrammaSection
  order       Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  description String?
  image       String?
  instagram   String?
  phone       String?
}

model ServiceCategory {
  id        String        @id
  title     String
  titleEn   String?
  icon      String
  color     String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     ServiceItem[]
}

model ServiceItem {
  id            String          @id @default(uuid())
  name          String
  nameEn        String?
  description   String
  descriptionEn String?
  href          String?
  order         Int             @default(0)
  categoryId    String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model WhatsAppGroup {
  id            String                @id @default(uuid())
  name          String
  nameEn        String?
  link          String
  category      WhatsAppGroupCategory
  department    String?
  description   String?
  descriptionEn String?
  icon          String?
  theme         String?
  order         Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  isGeneral     Boolean               @default(false)
  semester      String?
  subcategory   String?
}

model Guide {
  id                 String      @id
  title              String
  titleEn            String?
  description        String
  descriptionEn      String?
  icon               String
  color              String
  order              Int         @default(0)
  hasCustomComponent Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  steps              GuideStep[]
}

model GuideStep {
  id            String   @id @default(uuid())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  order         Int      @default(0)
  guideId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attachments   String?
  guide         Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

model GradeSimulation {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  exams        Json
  targetCfu    Int      @default(180)
  targetType   String   @default("180")
  lodeAs31     Boolean  @default(false)
  thesisPoints Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BienniumConfig {
  term      String   @id
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganigrammaConfig {
  id        String   @id @default("config")
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model MediaLibraryItem {
  id        String   @id @default(uuid())
  url       String   @unique
  name      String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

model DeadlineCountdown {
  id            String          @id @default(uuid())
  title         String
  titleEn       String?
  category      String
  date          DateTime
  description   String
  descriptionEn String?
  visible       Boolean         @default(true)
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  alerts        DeadlineAlert[]
}

model DeadlineAlert {
  id           String            @id @default(uuid())
  email        String
  countdownId  String
  sentOneMonth Boolean           @default(false)
  sentOneWeek  Boolean           @default(false)
  sentFiveDays Boolean           @default(false)
  sentOneDay   Boolean           @default(false)
  locale       String            @default("it")
  createdAt    DateTime          @default(now())
  countdown    DeadlineCountdown @relation(fields: [countdownId], references: [id], onDelete: Cascade)

  @@unique([email, countdownId])
}

model RateLimit {
  id        String   @id @default(uuid())
  key       String
  window    String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([key, window])
  @@index([key])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN_NETWORK
  ADMIN_MORGANA
  SUPER_ADMIN
}

enum Association {
  MORGANA_ORUM
  PIAZZA_DELLARTE
}

enum OrganigrammaAssociation {
  MORGANA
  ORUM
}

enum OrganigrammaSection {
  PRESIDENCY
  BOARD
  COORDINATOR
  RESPONSIBLE
  DEPARTMENT
}

enum WhatsAppGroupCategory {
  ACADEMIC
  COMMUNITY
  SANITARY_VET
}

model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
