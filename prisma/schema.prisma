generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  name             String
  surname          String
  birthDate        DateTime
  matricola        String         @unique
  department       String
  degreeCourse     String
  isFuorisede      Boolean
  qrToken          String         @unique @default(uuid())
  createdAt        DateTime       @default(now())
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  newsletter                     Boolean        @default(false)
  consenso_marketing_orum        Boolean        @default(false)
  consenso_marketing_morgana     Boolean        @default(false)
  accettazione_termini_condivisi Boolean        @default(false)
  role                           Role           @default(USER)
  association                    Association    @default(MORGANA_ORUM)
  registrations                  Registration[]
  gradeSimulation                GradeSimulation?
}

model Event {
  id             Int            @id @default(autoincrement())
  title          String
  titleEn        String?
  description    String
  descriptionEn  String?
  date           DateTime
  location       String
  image          String?
  category       String
  attachments    String?
  bookingEnd     DateTime?
  bookingOpen    Boolean        @default(true)
  bookingStart   DateTime?
  details        String?
  detailsEn      String?
  endDate        DateTime?
  cfuDepartments String?
  cfuType        String?
  cfuValue       String?
  published      Boolean        @default(true)
  youtubeUrl     String?
  associations   Association[]  @default([MORGANA_ORUM])
  registrations  Registration[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  @@index([date])
  @@index([category])
}

model Registration {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  status    String   @default("REGISTERED")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model Representative {
  id              String      @id @default(uuid())
  name            String
  listName        String
  category        String
  department      String?
  role            String?
  term            String      @default("2025-2027")
  image           String?
  email           String?
  phone           String?
  instagram       String?
  description     String?
  roleDescription String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  association     Association @default(MORGANA_ORUM)
}

model News {
  id           String        @id @default(uuid())
  title        String
  titleEn      String?
  description  String
  descriptionEn String?
  content      String?
  contentEn    String?
  category     String
  tags         String?
  image        String?
  date         DateTime      @default(now())
  published    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  associations Association[] @default([MORGANA_ORUM])

  @@index([date])
  @@index([category])
}

model Convention {
  id        String   @id @default(uuid())
  name      String
  category  String
  social    String?
  logo      String?
  website   String?
  location  String
  discounts String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
  @@index([category])
}

model NewsCategory {
  id   String @id @default(uuid())
  name String @unique
}

model EventCategory {
  id   String @id @default(uuid())
  name String @unique
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  titleEn   String?
  message   String
  messageEn String?
  type      String
  link      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AnalyticEvent {
  id        Int      @id @default(autoincrement())
  type      String   // "VISIT", "CLICK", "EVENT_VIEW", etc.
  page      String?  // The URL or page name
  targetId  String?  // ID of the target (e.g., eventId)
  metadata  Json?    // Extra info (browser, platform, etc.)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN_NETWORK
  ADMIN_MORGANA
  SUPER_ADMIN
}

enum Association {
  MORGANA_ORUM
  UNIMHEALTH
  ECONOMIA
  SCIPOG
  DICAM
  MATRICOLE
  INSIDE_DICAM
  PIAZZA_DELLARTE
}

model PiazzaArtist {
  id        String   @id @default(uuid())
  name      String
  role      String
  category  String   // Musica, Danza, Pittura, Performance
  bio       String
  image     String?
  badge     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PiazzaProgramItem {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String?  // Added field
  timeSlot    String   // Mattino, Pomeriggio, Sera
  startTime   String?  // HH:mm
  endTime     String?  // HH:mm
  icon        String?  // Lucide icon name
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PiazzaMediaItem {
  id          String   @id @default(uuid())
  type        String   // VIDEO, PHOTO, INTERVIEW
  title       String
  description String?
  url         String?  // YouTube URL or Image path
  thumbnail   String?
  personName  String?  // For interviews
  personRole  String?  // For interviews
  duration    String?  // For videos
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PiazzaSettings {
  id               String   @id @default("settings")
  year             String   @default("2026")
  eventDate        DateTime @default("2026-05-22T09:00:00Z")
  countdownVisible Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model PiazzaSponsor {
  id        String   @id @default(uuid())
  name      String
  logo      String?
  website   String?
  tier      String?  // Main, Partner, etc.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganigrammaMember {
  id          String   @id @default(uuid())
  name        String
  role        String   // Role title (e.g. "Presidente") or Department name (e.g. "Dipartimento Attività Culturali")
  roleEn      String?  // Optional English translation
  email       String?
  association String   // "MORGANA" or "ORUM"
  section     String   // "PRESIDENCY", "BOARD", "DEPARTMENT"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceCategory {
  id        String        @id // Text ID/slug (e.g., "accademici", "ersu") used for scroll-anchors
  title     String
  titleEn   String?
  icon      String        // Lucide icon name string
  color     String        // Tailwind/styling color key (e.g., "blue", "orange")
  order     Int           @default(0)
  items     ServiceItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ServiceItem {
  id            String          @id @default(uuid())
  name          String
  nameEn        String?
  description   String
  descriptionEn String?
  href          String?
  order         Int             @default(0)
  categoryId    String
  category      ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model WhatsAppGroup {
  id            String   @id @default(uuid())
  name          String
  nameEn        String?
  link          String
  category      String   // "ACADEMIC" or "COMMUNITY"
  department    String?  // For academic groups (e.g., "Economia")
  description   String?  // For community groups
  descriptionEn String?
  icon          String?  // Icon name for community groups
  theme         String?  // CSS styling / theme for community groups
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Guide {
  id                 String      @id // Text ID/slug (e.g., "matricole", "trasporti")
  title              String
  titleEn            String?
  description        String
  descriptionEn      String?
  icon               String
  color              String
  order              Int         @default(0)
  hasCustomComponent Boolean     @default(false)
  steps              GuideStep[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model GuideStep {
  id            String   @id @default(uuid())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  order         Int      @default(0)
  guideId       String
  guide         Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GradeSimulation {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams        Json     // Stores the array of simulated exams
  targetCfu    Int      @default(180)
  targetType   String   @default("180")
  lodeAs31     Boolean  @default(false)
  thesisPoints Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}



